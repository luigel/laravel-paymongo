{
    "name": "luigel/laravel-paymongo",
    "description": "A laravel wrapper for Paymongo API",
    "keywords": [
        "luigel",
        "laravel-paymongo",
        "laravel",
        "paymongo",
        "gcash",
        "credit-cards",
        "debit-cards",
        "grabcar",
        "payment-gateway"
    ],
    "homepage": "https://github.com/luigel/laravel-paymongo",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Rigel Kent Carbonel",
            "email": "rigel20.kent@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Luigel\\Paymongo\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Luigel\\Paymongo\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Luigel\\Paymongo\\PaymongoServiceProvider"
            ],
            "aliases": {
                "Paymongo": "Luigel\\Paymongo\\Facades\\Paymongo"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
