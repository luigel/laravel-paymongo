{
    "name": "luigel/laravel-paymongo",
    "description": "A laravel wrapper for Paymongo API",
    "keywords": [
        "luigel",
        "laravel-paymongo",
        "laravel",
        "paymongo",
        "gcash",
        "credit-cards",
        "debit-cards",
        "grabcar",
        "payment-gateway"
    ],
    "homepage": "https://github.com/luigel/laravel-paymongo",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Rigel Kent Carbonel",
            "email": "rigel20.kent@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-type-coverage": "^3.0|^4.0",
        "phpmd/phpmd": "^2.15",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Luigel\\Paymongo\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Luigel\\Paymongo\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest tests/Unit tests/Feature tests/Arch",
        "test:unit": "vendor/bin/pest tests/Unit",
        "test:feature": "vendor/bin/pest tests/Feature",
        "test:arch": "vendor/bin/pest tests/Arch",
        "test:coverage": "vendor/bin/pest tests/Unit tests/Feature tests/Arch --coverage --min=100",
        "test:types": "php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100",
        "test:all": [
            "@test",
            "@test:types"
        ],
        "lint": [
            "@lint:pint",
            "@lint:phpstan",
            "@lint:phpmd"
        ],
        "lint:pint": "vendor/bin/pint --test",
        "lint:phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "lint:phpmd": "vendor/bin/phpmd src text phpmd.xml",
        "analyse": "@lint:phpstan",
        "format": "vendor/bin/pint",
        "refactor": [
            "vendor/bin/rector process",
            "@format"
        ],
        "refactor:dry": "vendor/bin/rector process --dry-run",
        "check": [
            "@lint",
            "@refactor:dry",
            "@test:all"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the unit, feature and architecture suites",
        "test:coverage": "Run the suites with line coverage enforced at 100% (needs pcov or xdebug)",
        "test:types": "Enforce 100% type coverage on src",
        "test:all": "Run the suites plus type coverage",
        "lint": "Pint in check mode, then PHPStan (Larastan level 8), then PHPMD",
        "format": "Fix code style with Pint",
        "refactor": "Apply Rector's refactorings, then Pint",
        "refactor:dry": "Show what Rector would change without writing anything",
        "check": "Everything CI runs: lint, refactor:dry and test:all"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Luigel\\Paymongo\\PaymongoServiceProvider"
            ],
            "aliases": {
                "Paymongo": "Luigel\\Paymongo\\Facades\\Paymongo"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
