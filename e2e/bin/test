#!/usr/bin/env bash
#
# Run the end-to-end Pest suite inside the same container that serves the app,
# so the tests and the HTTP server share database/database.sqlite.
#
# Extra arguments are passed through to Pest, e.g.
#   e2e/bin/test --filter=webhook
set -euo pipefail

E2E_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$E2E_DIR/docker-compose.yml"

dc() { docker compose -f "$COMPOSE_FILE" --project-directory "$E2E_DIR" "$@"; }

if [ -z "$(dc ps -q app 2>/dev/null)" ]; then
    printf '\033[0;31merror:\033[0m the e2e app is not running. Run e2e/bin/setup first.\n' >&2
    exit 1
fi

tty_flag=(-T)
if [ -t 0 ] && [ -t 1 ]; then
    tty_flag=()
fi

exec docker compose -f "$COMPOSE_FILE" --project-directory "$E2E_DIR" \
    exec "${tty_flag[@]}" -e PAYMONGO_E2E=1 app \
    vendor/bin/pest -c phpunit.e2e.xml tests/E2E "$@"
