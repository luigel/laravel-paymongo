# Copy to e2e/.env and fill in. e2e/.env is git-ignored — never commit real keys.

# PayMongo TEST-MODE keys. bin/setup refuses to run with anything but sk_test_*.
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here

# Which public tunnel to run: cloudflared (default, zero config) or ngrok.
TUNNEL=cloudflared

# ngrok only. NGROK_DOMAIN is optional; with a reserved static domain the
# webhook registered with PayMongo can be reused between runs.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Optional host port overrides (change if 8000/4040 are already taken).
# APP_PORT=8000
# NGROK_WEB_PORT=4040

# Do NOT set PAYMONGO_WEBHOOK_SECRET here: values in this file are injected
# into the container environment and would shadow the value bin/setup writes
# into e2e/app/.env after registering the webhook.
